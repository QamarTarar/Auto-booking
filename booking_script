import time
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

print("=" * 50)
print("AUTO BOOKING BOT STARTED")
print("=" * 50)

# Your login credentials
EMAIL = "zs.shah100@gmail.com"
PASSWORD = "Syedsarkar1"

try:
    # Setup Chrome
    print("1. Setting up Chrome browser...")
    options = Options()
    options.add_argument('--headless')
    options.add_argument('--no-sandbox')
    options.add_argument('--disable-dev-shm-usage')
    options.add_argument('--disable-blink-features=AutomationControlled')
    options.add_experimental_option("excludeSwitches", ["enable-automation"])
    
    driver = webdriver.Chrome(options=options)
    print("✓ Chrome started successfully")
    
    # Open website
    print("2. Opening website...")
    driver.get("https://schedule.cf-grcon-isl-pakistan.com/schedule/grcon-isl-pakistan")
    time.sleep(3)
    print(f"✓ Page loaded: {driver.title}")
    
    # Try to find and fill login form
    print("3. Looking for login form...")
    try:
        # Try common email field selectors
        email_field = driver.find_element(By.CSS_SELECTOR, "input[type='email'], input[name='email'], input[id*='email']")
        email_field.send_keys(EMAIL)
        print("✓ Email entered")
        
        password_field = driver.find_element(By.CSS_SELECTOR, "input[type='password'], input[name='password'], input[id*='password']")
        password_field.send_keys(PASSWORD)
        print("✓ Password entered")
        
        # Try to click login button
        login_btn = driver.find_element(By.CSS_SELECTOR, "button[type='submit'], input[type='submit'], button:contains('Login'), button:contains('Sign in')")
        login_btn.click()
        print("✓ Login clicked")
        time.sleep(3)
        
    except Exception as e:
        print(f"⚠ No login form found or already logged in: {e}")
    
    # Check for booking slots
    print("4. Checking for available slots...")
    page_text = driver.page_source.lower()
    
    if "book" in page_text or "available" in page_text or "slot" in page_text:
        print("🔔 POSSIBLE SLOTS FOUND!")
        
        # Try to find and click any book button
        try:
            book_buttons = driver.find_elements(By.XPATH, "//button[contains(text(), 'Book') or contains(text(), 'book') or contains(@class, 'book')]")
            if book_buttons:
                book_buttons[0].click()
                print("✅✅✅ BOOKING CLICKED! ✅✅✅")
            else:
                print("⚠ No clickable book button found")
        except:
            print("⚠ Could not click book button")
    else:
        print("❌ No slots available at this time")
    
    # Take screenshot
    driver.save_screenshot("booking_result.png")
    print("5. Screenshot saved: booking_result.png")
    
    driver.quit()
    print("=" * 50)
    print("✓ SCRIPT COMPLETED")
    print("=" * 50)
    
except Exception as e:
