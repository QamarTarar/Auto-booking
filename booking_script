import time
from selenium import webdriver
from selenium.webdriver.chrome.options import Options

print("=" * 50)
print("AUTO BOOKING SCRIPT STARTED")
print("=" * 50)

try:
    # Setup Chrome options
    chrome_options = Options()
    chrome_options.add_argument('--headless')
    chrome_options.add_argument('--no-sandbox')
    chrome_options.add_argument('--disable-dev-shm-usage')
    chrome_options.add_argument('--disable-gpu')
    
    print("Starting Chrome browser...")
    driver = webdriver.Chrome(options=chrome_options)
    
    print("Accessing website...")
    driver.get('https://schedule.cf-grcon-isl-pakistan.com/schedule/grcon-isl-pakistan')
    
    print(f"✓ Page loaded successfully!")
    print(f"Page title: {driver.title}")
    
    # Take a screenshot
    driver.save_screenshot('screenshot.png')
    print("✓ Screenshot saved")
    
    # Check for login form
    page_source = driver.page_source
    if 'login' in page_source.lower() or 'email' in page_source.lower():
        print("✓ Login form detected")
    else:
        print("⚠ No login form found - possible block")
    
    driver.quit()
    print("=" * 50)
    print("✓ SCRIPT COMPLETED SUCCESSFULLY")
    print("=" * 50)
    
except Exception as e:
    print(f"✗ ERROR: {e}")
    print("=" * 50)
    print("SCRIPT FAILED")
    print("=" * 50)
