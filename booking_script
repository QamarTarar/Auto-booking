from selenium import webdriver
from selenium.webdriver.common.by import By
import time

email = "zs.shah100@gmail.com"
password = "Syedsarkar1"

options = webdriver.ChromeOptions()
options.add_argument('--headless')
driver = webdriver.Chrome(options=options)

while True:
    try:
        driver.get("https://schedule.cf-grcon-isl-pakistan.com/schedule/grcon-isl-pakistan")
        time.sleep(3)
        
        # Try to login
        email_field = driver.find_element(By.NAME, "email")
        email_field.send_keys(email)
        password_field = driver.find_element(By.NAME, "password")
        password_field.send_keys(password)
        driver.find_element(By.XPATH, "//button[@type='submit']").click()
        
        time.sleep(2)
        
        # Check for book button
        buttons = driver.find_elements(By.XPATH, "//button[contains(text(), 'Book') or contains(text(), 'book')]")
        if buttons:
            buttons[0].click()
            print("✅ BOOKED SUCCESSFULLY!")
            break
        else:
            print("⏳ No slots yet... checking again in 30 seconds")
            time.sleep(30)
    except Exception as e:
        print(f"Error: {e}")
        time.sleep(30)
